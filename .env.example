# LiveKit Cloud project credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Keys clients use to call this gateway (comma-separated). Generate: openssl rand -hex 32
GATEWAY_API_KEYS=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > token)
CLOUDFLARE_TUNNEL_TOKEN=

# Model used when a client sends a Claude model name or no model
DEFAULT_MODEL=openai/gpt-5.5
SMALL_MODEL=openai/gpt-5.4-mini
# Optional: {"my-alias":"google/gemini-3.5-flash"}
MODEL_ALIASES=
MODEL_REFRESH_HOURS=6

# Credit tracking shown on the landing page
CREDIT_TOTAL_USD=17000
# Spend before the gateway started tracking (from LiveKit Cloud > Billing)
CREDIT_USED_BEFORE_USD=0
